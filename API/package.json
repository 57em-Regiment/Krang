{
  "name": "kran-api",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main.js",
  "scripts": {
    "dev": "pnpm --filter @57eme-regiment/krang-api-contract dev & ts-node-dev --respawn -r tsconfig-paths/register src/main.ts --watch packages/contract/src",
    "build": "pnpm --filter @57eme-regiment/krang-api-contract build && tsc --project tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --name",
    "db:migrate": "drizzle-kit migrate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.1.2",
  "dependencies": {
    "@57eme-regiment/auth-contracts": "^1.11.1",
    "@57eme-regiment/auth-server": "^1.6.0",
    "@57eme-regiment/krang-api-contract": "workspace:*",
    "@57eme-regiment/nabu-errors": "link:../../Krang/nabu/packages/errors",
    "@57eme-regiment/nabu-fastify": "link:../../Krang/nabu/packages/fastify",
    "@57eme-regiment/nabu-logger": "link:../../Krang/nabu/packages/logger",
    "@57eme-regiment/renenutet-api-contract": "^0.4.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/type-provider-zod": "^1.0.0",
    "@scalar/fastify-api-reference": "^1.58.0",
    "@ts-rest/core": "3.53.0-rc.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "fastify": "^5.8.5",
    "pg": "^8.21.0",
    "postgres": "^3.4.9",
    "qs": "^6.15.2",
    "reflect-metadata": "^0.2.2",
    "tslog": "^4.10.2",
    "tsyringe": "^4.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/pg": "^8.20.0",
    "@types/qs": "^6.15.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.0"
  }
}