model Town {
  id            String @id @default(uuid())
  name          String

  longitude     Float //X repésente Est-Ouest
  latitude      Float //Y Repésente Nord/Sud

  mapMarkerType MapMarkerType

  regionId      String
  region        Region @relation(fields: [regionId], references: [id])

  location      Location[]

  @@unique([name, regionId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}
