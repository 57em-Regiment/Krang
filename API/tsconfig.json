{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "..",
    "types": ["node"],
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@57eme-regiment/auth-server": ["node_modules/@57eme-regiment/auth-package/dist/server/index.d.ts"],
      "@/*": ["src/*"],
      "@57eme-regiment/nabu-errors": ["../nabu/packages/errors/src/index.ts"],
      "@57eme-regiment/nabu-fastify": ["../nabu/packages/fastify/src/index.ts"],
      "@57eme-regiment/nabu-logger": ["../nabu/packages/logger/src/index.ts"]
    }
  },
  "include": ["src/**/*", "packages/contract/src/**/*"],
  "exclude": ["node_modules", "dist", "packages/contract/dist"]
}
