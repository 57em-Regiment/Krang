{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "types": ["node"],
    "rootDir": ".",
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@57eme-regiment/krang-api-contract": ["packages/contract/src/index.ts"],
      "@57eme-regiment/krang-api-contract/*": ["packages/contract/src/*"],
      "@57eme-regiment/auth-contracts": [
        "../../wan-shi-tong/packages/auth-contracts/src/index.ts"
      ],
      "@57eme-regiment/auth-contracts/*": [
        "../../wan-shi-tong/packages/auth-contracts/src/*"
      ],
      "@57eme-regiment/auth-server": [
        "../../wan-shi-tong/packages/auth-server/src/index.ts"
      ],
      "@57eme-regiment/renenutet-api-contract": [
        "../../Renenutet/packages/contract/src/index.ts"
      ],
      "@57eme-regiment/renenutet-api-contract/*": [
        "../../Renenutet/packages/contract/src/*"
      ],
      "@57eme-regiment/nabu-errors": ["nabu/packages/errors/src/index.ts"],
      "@57eme-regiment/nabu-fastify": ["nabu/packages/fastify/src/index.ts"],
      "@57eme-regiment/nabu-logger": ["nabu/packages/logger/src/index.ts"]
    }
  },
  "include": ["src/**/*", "packages/contract/src/**/*"],
  "exclude": ["node_modules", "dist", "packages/contract/dist"]
}
